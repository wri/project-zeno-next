NEXT_PUBLIC_RW_API_URL=https://api.resourcewatch.org
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
# closed | limited | public
NEXT_PUBLIC_LANDING_PAGE_VERSION=public
NEXT_PUBLIC_ENABLE_DEBUG_TOOLS=false
# Optional overrides (defaults in app/config/api.ts and the files noted)
# NEXT_PUBLIC_API_HOST=https://api.staging.globalnaturewatch.org
# NEXT_PUBLIC_EOAPI_HOST=https://eoapi-cache.globalnaturewatch.org/  # app/constants/datasets.ts
# NEXT_PUBLIC_SITE_URL=  # base URL for share links; defaults to the current origin
# NEXT_PUBLIC_PROTOTYPE_MODE=false  # true shows the PROTOTYPE badge
# NEXT_PUBLIC_EVALS_DATA_BRANCH=challenge-set  # src/features/evals/api/github.ts
